{
  "name": "codex-web-gpt-launcher",
  "version": "4.1.0",
  "private": true,
  "description": "Desktop control center for CodexWeb Council",
  "author": "miuuyy / Nolane-x",
  "type": "module",
  "main": "electron/main-dispatch.cjs",
  "scripts": {
    "dev": "bun run scripts/dev.cjs",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build": "bun run typecheck && bun run build:renderer",
    "build:runtime": "bun run scripts/prepare-runtime.cjs",
    "package": "bun run package:win",
    "package:win": "bun run build && bun run build:runtime && bun run scripts/package.cjs --win",
    "smoke:package": "bun run scripts/smoke-package.cjs",
    "test": "node scripts/test-active.cjs",
    "start": "electron ."
  },
  "dependencies": {"motion":"^12.42.2","react":"^19.0.0","react-dom":"^19.0.0"},
  "devDependencies": {"@types/node":"^22.10.2","@types/react":"^19.0.0","@types/react-dom":"^19.0.0","@vitejs/plugin-react":"^5.2.0","electron":"41.10.7","electron-builder":"^26.8.1","typescript":"^5.9.3","vite":"^6.0.0"},
  "overrides": {
    "@xmldom/xmldom@<=0.8.14":"0.8.15",
    "brace-expansion@<1.1.18":"1.1.18",
    "fast-uri@<3.1.8":"3.1.8",
    "js-yaml@>=4.0.0 <4.3.2":"4.3.2",
    "nanoid@<3.3.18":"3.3.18"
  },
  "build": {
    "appId":"dev.codexwebgpt.launcher","productName":"Codex Web GPT","artifactName":"codex-web-gpt-${version}-${os}-${arch}.${ext}","asar":true,
    "directories":{"output":"release"},
    "files":["dist/**","electron/**","assets/icon.png","package.json"],
    "extraResources":[{"from":"build/runtime","to":"runtime"}],
    "win":{"icon":"assets/icon.ico","target":["nsis"]},
    "nsis":{"oneClick":true,"perMachine":false,"allowElevation":false,"createDesktopShortcut":true,"createStartMenuShortcut":true,"runAfterFinish":false}
  }
}
